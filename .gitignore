# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
/playwright-report/
/test-results/
/reports/*
# Скриншоты и отчёты проверок, на которые ссылаются README и docs, хранятся в git
!/reports/stage-3/
!/reports/ui-polish/
/HANDOFF.md

# Local Netlify folder
.netlify

# Документация ведётся локально у владельца и в репозиторий не попадает
# (исключения: шаблоны писем входа для Supabase и скриншоты для README).
/docs/*
!/docs/email-templates/
!/docs/screenshots/
/AGENTS.md
/.claude/
.env*.local
