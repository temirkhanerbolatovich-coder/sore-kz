# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ИИ-карточка по фото (только сервер, не добавляйте NEXT_PUBLIC_).
# Достаточно ключа ОДНОГО провайдера; если задано несколько, при ошибке или лимите берётся следующий.
# 1) Google Gemini, бесплатно: ключ на https://aistudio.google.com/apikey
#    (на бесплатном тарифе Google может использовать запросы для улучшения своих продуктов)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
# 2) OpenRouter, бесплатные модели :free: ключ на https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
# 3) Anthropic (платный, по желанию)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# Порядок цепочки (по умолчанию gemini,openrouter,anthropic)
# AI_PROVIDERS=gemini,openrouter,anthropic
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=

# Публичный адрес сайта (для OG-ссылок)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# По умолчанию CSP только собирает отчёты; 1 включает блокировку на следующей сборке.
CSP_ENFORCE=

# Демо-магазин (slug из supabase/seed.sql)
DEMO_SLUG=demo

# Только сервер: атомарный лимит ИИ, не публиковать
SUPABASE_SERVICE_ROLE_KEY=

# Вход по коду из письма (по умолчанию выключен). Включайте (=1) только после настройки своего SMTP
# и загрузки шаблонов из docs/email-templates: встроенная почта Supabase на бесплатном тарифе их не принимает.
# NEXT_PUBLIC_EMAIL_CODE=1
# NEXT_PUBLIC_GOOGLE_LOGIN=1  # кнопка «Войти через Google» (после настройки провайдера в Supabase)
# NEXT_PUBLIC_CONTACT_EMAIL=      # контактный email на страницах условий и конфиденциальности
# NEXT_PUBLIC_UMAMI_ID=            # ID сайта в Umami Cloud (счётчик посещаемости без cookie); пусто = счётчик выключен
# Telegram: TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_NOTIFY_SECRET, ADMIN_TELEGRAM_CHAT_ID (см. docs/TELEGRAM.md)
# Вход в кабинет из бота одной кнопкой (/login): длинная случайная строка, от 32 символов. Без неё кнопка ведёт на обычный вход.
# BOT_LOGIN_SECRET=
# Vercel Cron: ежедневная уборка осиротевших фото (/api/cron/storage-cleanup). Длинная случайная строка, от 16 символов.
# CRON_SECRET=

# WhatsApp владельца сервиса для кнопки «Снять ограничения» (Pro): только цифры, с кодом страны
# NEXT_PUBLIC_SUPPORT_WHATSAPP=
